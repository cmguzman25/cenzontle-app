# Copia este archivo como .env y pon tus credenciales de Supabase.
# Ambas son públicas y viajan al navegador: se exponen desde la clave `env` de
# next.config.ts (por eso no necesitan el prefijo NEXT_PUBLIC_).
# Las encuentras en: Supabase → Project Settings → API

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
