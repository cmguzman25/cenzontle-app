# Copia este archivo como .env y pon tus credenciales de Supabase.
# Las encuentras en: Supabase → Project Settings → API

# Estas dos son públicas y viajan al navegador: se exponen desde la clave `env`
# de next.config.ts (por eso no necesitan el prefijo NEXT_PUBLIC_).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Alta manual de cuentas (/admin) ---
# El registro público está cerrado. Estas dos variables son SECRETAS: no están
# en next.config.ts, así que se quedan en el servidor y nunca van al navegador.

# Correos que pueden entrar a /admin y crear cuentas. Separados por comas.
# Si lo dejas vacío, nadie es administrador.
ADMIN_EMAILS=tu@correo.com

# Clave secreta (service_role). Se salta el RLS: no la subas a git ni la pongas
# en ningún archivo que llegue al navegador.
SUPABASE_SECRET_KEY=sb_secret_...
